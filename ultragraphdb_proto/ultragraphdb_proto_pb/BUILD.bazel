load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library", "rust_prost_transform")

# The proto library must have the same name as the crate in Cargo.toml to build with Bazel and Cargo. Badger's
# messages are part of it, so the generated crate holds both packages, as the Cargo build does.
proto_library(
    name = "ultragraphdb_proto_pb",
    srcs = [
        "proto/badgerpb4.proto",
        "proto/pb.proto",
    ],
    data = [":no_transport"],
    strip_import_prefix = "proto",
    visibility = ["//visibility:public"],
    deps = ["//ultragraphdb_proto/ultragraphdb_proto_dgraph"],
)

# Zero's service has an RPC named Connect, whose client method collides with tonic's transport constructor
# `connect`; build.rs turns the transport constructors off for Cargo, and this transform does so for Bazel.
rust_prost_transform(
    name = "no_transport",
    tonic_opts = ["no_transport"],
)

rust_prost_library(
    name = "ultragraphdb_proto_pb_bindings",
    proto = ":ultragraphdb_proto_pb",
    visibility = ["//visibility:public"],
)
