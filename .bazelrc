# Bazel configuration for ultragraphdb.
#
# Don't create bazel-* symlinks in the project root directory.
# Instead, set a prefix and put it in .gitignore
build --symlink_prefix=target-bzl/

# Write build outputs in a platform-specific directory; avoid outputs being wiped and rewritten
# when switching between platforms.
common --experimental_platform_in_output_dir
common --noannounce_rc
common --color=yes
common --ui_event_filters=-INFO
common --enable_platform_specific_config

# macOS holds a Unix socket's path in 104 bytes with its NUL (`sockaddr_un`), so a path is at most 103 bytes, and the
# tests bind their sockets inside TEST_TMPDIR. By default that is <output_base>/execroot/_main/_tmp/<32 hex>, 129
# bytes under ~/Library/Caches/bazel. A shorter --output_user_root does not fit either: Bazel resolves /tmp/u to
# /private/tmp/u and adds a 32-hex output base, 14 + 1 + 32 + 21 + 32 = 100 bytes, leaving 2 for a socket's name.
# TEST_TMPDIR's own root is short instead: /private/tmp/ut/_tmp/<32 hex> is 15 + 6 + 32 = 53 bytes, leaving
# 103 - 53 - 1 = 49 for a socket's name (the compio tests' longest is 20). The cache stays where it is. Linux's
# 108-byte limit holds under its default root.
test:macos --test_tmpdir=/tmp/ut

build --keep_going
build --jobs=auto
build --show_timestamps

# Show failing logs. A test runs once: a failure on any run is a failure, since a test that fails intermittently is a race to find.
test --test_output=errors

# Integer overflow panics in every build, release included: a wrapped offset, length or epoch written to disk is
# corruption, and a stop is not. Cargo's [profile.release] says the same; Bazel reads no Cargo profile, and a binary's
# release_flags reach only its own crate, so the flag goes to every target here.
build --@rules_rust//rust/settings:extra_rustc_flag=-Coverflow-checks=on

# Allow developers to extend configuration locally (ignored in version control).
try-import %workspace%/.bazelrc.local
