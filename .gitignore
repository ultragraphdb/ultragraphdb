# Generated by Cargo
# will have compiled files and executables
debug
target

# Bazel output, under the symlink prefix .bazelrc sets
target-bzl/

# Local Bazel settings
.bazelrc.local

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
.idea/

# Binary built by `go build` in the golden-vector generator
tools/golden/golden

# Lake's build output for the Lean proofs under lean/
lean/.lake/

# cargo-fuzz output in the fuzz workspace: builds, working corpora, crash artifacts and coverage. Seeds come from the
# crates' golden test data, and minimized failing inputs are committed under each crate's testdata/fuzz_regressions/.
fuzz/target/
fuzz/*/target/
fuzz/*/corpus/
fuzz/*/artifacts/
fuzz/*/coverage/
/website/.wrangler/
