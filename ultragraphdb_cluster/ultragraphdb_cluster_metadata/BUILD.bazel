load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test")

rust_library(
    name = "ultragraphdb_cluster_metadata",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_cluster_metadata"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_cluster_metadata",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":ultragraphdb_cluster_metadata",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

# One rust_test, not a suite: tests/ mirrors src/, so the test files are modules reached through tests/mod.rs. The
# fuzz seeds are runfiles: a test decodes each. The group's log is the write-ahead log over its simulated storage.
rust_test(
    name = "ultragraphdb_cluster_metadata_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = [
            "tests/bdd.rs",
            "tests/loom/**",
            "tests/utils/cluster.rs",
            "tests/utils/partition_model.rs",
        ],
    ),
    crate_root = "tests/mod.rs",
    data = glob(["testdata/**"]),
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_cluster_metadata"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The library again under `--cfg loom`, the leased blocks' queue built on Loom's types, for the Loom tests alone.
rust_library(
    name = "ultragraphdb_cluster_metadata_loom",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "ultragraphdb_cluster_metadata",
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    rustc_flags = [
        "--cfg",
        "loom",
    ],
    deps = all_crate_deps(normal = True) + ["@crates//:loom"],
)

# The Loom tests, under `tests/loom/`, mirroring `src/`: every interleaving of each model's threads, against the
# library built under `--cfg loom`.
rust_test(
    name = "loom",
    srcs = glob(["tests/loom/**/*.rs"]),
    crate_root = "tests/loom/mod.rs",
    rustc_flags = [
        "--cfg",
        "loom",
    ],
    tags = ["loom-test"],
    deps = [
        ":ultragraphdb_cluster_metadata_loom",
        "//ultragraphdb_core/ultragraphdb_core_ids",
        "//ultragraphdb_tool/ultragraphdb_tool_bdd",
        "//ultragraphdb_traits/ultragraphdb_traits_blocks",
        "@crates//:loom",
    ],
)

# cucumber runs its own main: the libtest harness is off, and the feature files are runfiles. bdd.rs includes the unit
# tests' harness by path.
rust_test(
    name = "bdd",
    srcs = [
        "tests/bdd.rs",
        "tests/utils/cluster.rs",
        "tests/utils/harness.rs",
        "tests/utils/partition_model.rs",
    ],
    crate_root = "tests/bdd.rs",
    data = glob(["features/**/*.feature"]),
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_cluster_metadata"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
