load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc")

rust_library(
    name = "ultragraphdb_cluster_partition",
    srcs = glob(["src/**/*.rs"]),
    # aliases() names every dependency, dev-dependencies included; the test helpers depend on this library, so their
    # alias stays with the test targets.
    aliases = {
        label: name
        for label, name in aliases().items()
        if label not in [
            "//ultragraphdb_common/ultragraphdb_common_storage",
            "//ultragraphdb_tool/ultragraphdb_tool_test",
        ]
    },
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_cluster_partition"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_cluster_partition",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

# One rust_test, not a suite: tests/ mirrors src/, so the test files are modules reached through tests/mod.rs.
rust_test(
    name = "ultragraphdb_cluster_partition_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = [
            "tests/bdd.rs",
            "tests/workload_faults.rs",
            "tests/workload_seeds.rs",
        ],
    ),
    crate_root = "tests/mod.rs",
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_cluster_partition"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# cucumber runs its own main: the libtest harness is off, and the feature files are runfiles. bdd.rs includes the unit
# tests' cluster fixture by path.
rust_test(
    name = "bdd",
    srcs = [
        "tests/bdd.rs",
        "tests/utils/cluster.rs",
        "tests/utils/hosts.rs",
    ],
    crate_root = "tests/bdd.rs",
    data = glob(["features/**/*.feature"]),
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_cluster_partition"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The simulator's workload over several partitions, each seed run in full; one target per run, as the tests take seconds.
[
    rust_test(
        name = workload,
        srcs = ["tests/{}.rs".format(workload)],
        crate_root = "tests/{}.rs".format(workload),
        tags = ["unit-test"],
        deps = [":ultragraphdb_cluster_partition"] + all_crate_deps(
            normal = True,
            normal_dev = True,
        ),
    )
    for workload in [
        "workload_faults",
        "workload_seeds",
    ]
]
