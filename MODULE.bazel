module(
    name = "ultragraphdb",
    version = "0.0.0",
    repo_name = "ultragraphdb",
)

###############################################################################
# Bazel Rules: https://registry.bazel.build/home/
###############################################################################
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_img", version = "0.3.21")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "llvm", version = "0.8.26")
bazel_dep(name = "rules_rs", version = "0.2.1")

###############################################################################
# Hermetic LLVM: the cc toolchain: github.com/hermeticbuild/hermetic-llvm
###############################################################################
llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm")

# Matches the LLVM that rustc RUST_DEFAULT_VERSION below is built on. Confirmed with
# `rustc --version --verbose`. Keep the two in sync.
llvm.version(llvm_version = "23.1.0")
use_repo(llvm, "llvm-project")

# The macOS sysroot. The web.archive entry is a fallback in case the Apple URL returns 503.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.from_archive(
    sha256 = "5f044578cd78a3a9b9c965a42d56bad609ee5d252e1d4e6aa7c42fc3f35fee7b",
    strip_prefix = "Payload/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk",
    type = "pkg",
    urls = [
        "https://swcdn.apple.com/content/downloads/09/08/047-91568-A_Y1CFZWQCD4/4xekpyz43i26dbp4enxfro8eb1q7wiujh5/CLTools_macOSNMOS_SDK.pkg",
        "https://web.archive.org/web/20260512015547id_/https://swcdn.apple.com/content/downloads/09/08/047-91568-A_Y1CFZWQCD4/4xekpyz43i26dbp4enxfro8eb1q7wiujh5/CLTools_macOSNMOS_SDK.pkg",
    ],
)
osx.frameworks(names = [
    "System",
    "CoreFoundation",
    "Foundation",
    "Kernel",
    "OSLog",
    "Security",
    "SystemConfiguration",
])

register_toolchains("@llvm//toolchain:all")

###############################################################################
# Rust toolchain: https://github.com/hermeticbuild/rules_rs
###############################################################################
rules_rs_rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rs_rules_rust, "rules_rust")

RUST_DEFAULT_VERSION = "1.99.1"

RUST_EDITION = "2024"

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = RUST_EDITION,
    version = RUST_DEFAULT_VERSION,
)
use_repo(toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

# The triples the dependency graph is RESOLVED for, which is not the same thing as
# cross-compiling: rules_rs evaluates each crate's target-specific dependencies once per triple.
# The first three are the machines this repository is built on; the two musl triples are build
# targets for statically linked binaries.
RUST_PLATFORMS = [
    "aarch64-apple-darwin",
    "aarch64-unknown-linux-gnu",
    "x86_64-unknown-linux-gnu",
    "aarch64-unknown-linux-musl",
    "x86_64-unknown-linux-musl",
]

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    generate_lint_config = True,
    platform_triples = RUST_PLATFORMS,
)

# cucumber embeds env!("CARGO_MANIFEST_DIR") as a fallback for relative feature paths (src/parser/basic.rs:83), and
# rules_rs refuses compiled output embedding the sandbox path. The BDD runners pass absolute paths, so a relative
# value is inert. Proved in the stage-1 design, "BDD with cucumber-rs".
crate.annotation(
    crate = "cucumber",
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
)
use_repo(crate, "crates")

###############################################################################
# rules_img: https://github.com/bazel-contrib/rules_img
# The image rules are //bazel/container:img.bzl, and the release binary rule is //bazel:binary.bzl, both taken from
# scrith.
###############################################################################
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Mozilla's CA bundle as curl publishes it, the trust store of //bazel/oci_images/scrach_base. Dated and pinned by its
# SHA-256, which curl publishes beside it; update both together.
http_file(
    name = "mozilla_cacert",
    downloaded_file_path = "ca-certificates.crt",
    sha256 = "796f1389bfea13c0ed78f663b765baaff54a508e5483786bd6ece73c5e3e3cbe",
    urls = ["https://curl.se/ca/cacert-2026-10-20.pem"],
)

###############################################################################
# rules_apko: https://github.com/chainguard-dev/rules_apko
# The glibc runtime base of the server image (D7), built from Wolfi packages and pinned by
# //bazel/oci_images/glibc_base:apko.lock.json; `bazel run //bazel/oci_images/glibc_base:lock` refreshes it.
###############################################################################
bazel_dep(name = "rules_apko", version = "1.5.56")

apko = use_extension("@rules_apko//apko:extensions.bzl", "apko")
apko.toolchain(apko_version = "v1.1.12")
use_repo(apko, "apko_toolchains")

register_toolchains("@apko_toolchains//:all")

apko.translate_lock(
    name = "glibc_base_lock",
    lock = "//bazel/oci_images/glibc_base:apko.lock.json",
)
use_repo(apko, "glibc_base_lock")
