load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test")

rust_library(
    name = "ultragraphdb_store_apply",
    srcs = glob(["src/**/*.rs"]),
    # aliases() names every dependency, dev-dependencies included; the test helpers depend on this library, so their
    # alias stays with the test targets.
    aliases = {
        label: name
        for label, name in aliases().items()
        if label != "//ultragraphdb_tool/ultragraphdb_tool_test"
    },
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_store_apply"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_store_apply",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

# The crate's example runs over the simulated store, a dev-dependency, as Cargo links dev-dependencies into doc tests.
rust_doc_test(
    name = "doc_test",
    crate = ":ultragraphdb_store_apply",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal_dev = True),
)

# The library again under `--cfg loom`, the changeset core's locks and flag built on Loom's types, for the Loom tests
# alone.
rust_library(
    name = "ultragraphdb_store_apply_loom",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "ultragraphdb_store_apply",
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    rustc_flags = [
        "--cfg",
        "loom",
    ],
    deps = all_crate_deps(normal = True) + ["@crates//:loom"],
)

# The Loom tests, under `tests/loom/`, mirroring `src/`: every interleaving of each model's threads, against the
# library built under `--cfg loom`, over the simulated store.
rust_test(
    name = "loom",
    srcs = glob(["tests/loom/**/*.rs"]),
    crate_root = "tests/loom/mod.rs",
    rustc_flags = [
        "--cfg",
        "loom",
    ],
    tags = ["loom-test"],
    deps = [
        ":ultragraphdb_store_apply_loom",
        "//ultragraphdb_core/ultragraphdb_core_mapping",
        "//ultragraphdb_store/ultragraphdb_store_posting",
        "//ultragraphdb_store/ultragraphdb_store_sim",
        "//ultragraphdb_traits/ultragraphdb_traits_blocks",
        "@crates//:loom",
        "@crates//:oxrdf",
    ],
)

# One rust_test, not a suite: tests/ mirrors src/, so the test files are modules reached through tests/mod.rs. It
# holds the fixed seed set of the apply workload on the simulated store, and the stage's operations on fjall under
# TEST_TMPDIR.
rust_test(
    name = "ultragraphdb_store_apply_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = [
            "tests/bdd.rs",
            "tests/catalog_change_steps.rs",
            "tests/changeset_steps.rs",
            "tests/loom/**",
            "tests/schema_storage_steps.rs",
            "tests/transaction_steps.rs",
            "tests/utils/probe.rs",
            "tests/vector_steps.rs",
            "tests/workload_*.rs",
        ],
    ),
    crate_root = "tests/mod.rs",
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_store_apply"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The changeset workload on the simulator: its rounds replayed logically into a replica, the fixed seeds without faults,
# with faults, and a seed's replay, one target each so that Bazel runs them in parallel with the unit tests. The workload itself is ultragraphdb_tool_test's.
[
    rust_test(
        name = workload,
        srcs = ["tests/%s.rs" % workload],
        crate_root = "tests/%s.rs" % workload,
        tags = ["unit-test"],
        deps = [":ultragraphdb_store_apply"] + all_crate_deps(
            normal = True,
            normal_dev = True,
        ),
    )
    for workload in [
        "workload_differential",
        "workload_faults",
        "workload_replay",
        "workload_seeds",
    ]
]

# cucumber runs its own main: the libtest harness is off, and the feature files are runfiles. bdd.rs includes the
# changeset helpers and the probe store by path.
rust_test(
    name = "bdd",
    srcs = [
        "tests/bdd.rs",
        "tests/catalog_change_steps.rs",
        "tests/changeset_steps.rs",
        "tests/schema_storage_steps.rs",
        "tests/statement_steps.rs",
        "tests/transaction_steps.rs",
        "tests/utils/changesets.rs",
        "tests/utils/probe.rs",
        "tests/vector_steps.rs",
    ],
    crate_root = "tests/bdd.rs",
    data = glob(["features/**/*.feature"]),
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_store_apply"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
