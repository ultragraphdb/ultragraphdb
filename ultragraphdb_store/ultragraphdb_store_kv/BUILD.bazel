load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test")

rust_library(
    name = "ultragraphdb_store_kv",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    # aliases() names every dependency, dev-dependencies included; the test helpers depend on this library, so their
    # alias stays with the test targets.
    aliases = {
        label: name
        for label, name in aliases().items()
        if label != "//ultragraphdb_tool/ultragraphdb_tool_test"
    },
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_store_kv"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

# Writes batches and drops into a store until the crash test kills it; a data dependency of the tests that kill it.
rust_binary(
    name = "kv_crash_writer",
    srcs = ["src/bin/kv_crash_writer.rs"],
    crate_root = "src/bin/kv_crash_writer.rs",
    lint_config = lint_config(),
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_store_kv"] + all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_store_kv",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":ultragraphdb_store_kv",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

# One rust_test, not a suite: tests/ mirrors src/, so the test files are modules reached through tests/mod.rs. Every
# store lives under TEST_TMPDIR; the helpers the targets share are ultragraphdb_tool_test's.
rust_test(
    name = "ultragraphdb_store_kv_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = [
            "tests/batch_gib.rs",
            "tests/bdd.rs",
            "tests/crash*.rs",
            "tests/fjall_workload_*.rs",
        ],
    ),
    crate_root = "tests/mod.rs",
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_store_kv"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# A batch of 1 GiB: about 2 GiB of memory and 20 s, so it runs as a target of its own beside the others. It keeps the
# unit-test tag, so `make test` runs it.
rust_test(
    name = "batch_gib",
    size = "large",
    srcs = ["tests/batch_gib.rs"],
    crate_root = "tests/batch_gib.rs",
    tags = ["unit-test"],
    deps = [":ultragraphdb_store_kv"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Kill the writer binary, a declared data dependency, during a batch, a drop, a temporary keyspace's life and a
# rebuild record's write: one target each, so Bazel runs them in parallel. Their stores live under TEST_TMPDIR.
[
    rust_test(
        name = crash,
        size = "medium",
        srcs = ["tests/%s.rs" % crash],
        crate_root = "tests/%s.rs" % crash,
        data = [":kv_crash_writer"],
        env = {"KV_CRASH_WRITER": "$(rootpath :kv_crash_writer)"},
        tags = ["unit-test"],
        deps = [":ultragraphdb_store_kv"] + all_crate_deps(
            normal = True,
            normal_dev = True,
        ),
    )
    for crash in [
        "crash",
        "crash_drop",
        "crash_rebuild",
        "crash_temporary",
    ]
]

# The simulator's store workload run on fjall beside the simulated store, without faults and with crashes between
# steps: one target each, beside the unit tests.
[
    rust_test(
        name = workload,
        srcs = ["tests/%s.rs" % workload],
        crate_root = "tests/%s.rs" % workload,
        tags = ["unit-test"],
        deps = [":ultragraphdb_store_kv"] + all_crate_deps(
            normal = True,
            normal_dev = True,
        ),
    )
    for workload in [
        "fjall_workload_checks",
        "fjall_workload_crashes",
    ]
]

# cucumber runs its own main: the libtest harness is off, and the feature files and the crash writer are runfiles.
rust_test(
    name = "bdd",
    srcs = ["tests/bdd.rs"],
    crate_root = "tests/bdd.rs",
    data = glob(["features/**/*.feature"]) + [":kv_crash_writer"],
    env = {"KV_CRASH_WRITER": "$(rootpath :kv_crash_writer)"},
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_store_kv"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Criterion benches of the store alone, one binary each, run with `bazel run :<name> -- --bench` and never as a test:
# no test rule wraps them, and `make test` builds them without running them. Each writes its store under the system's
# temporary directory.
[
    rust_binary(
        name = bench,
        srcs = [
            "benches/bench_dir.rs",
            "benches/%s.rs" % bench,
        ],
        crate_root = "benches/%s.rs" % bench,
        lint_config = lint_config(),
        tags = ["bench"],
        visibility = ["//visibility:public"],
        deps = [":ultragraphdb_store_kv"] + all_crate_deps(
            normal = True,
            normal_dev = True,
        ),
    )
    for bench in [
        "kv_batch_write_bench",
        "kv_compact_bench",
        "kv_drop_prefix_bench",
        "kv_list_cache_bench",
        "kv_point_read_bench",
        "kv_prefix_scan_bench",
    ]
]
