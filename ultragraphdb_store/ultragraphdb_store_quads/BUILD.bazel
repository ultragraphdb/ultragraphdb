load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test")
load("//bazel/rust:deps.bzl", "with_proto_bindings")

rust_library(
    name = "ultragraphdb_store_quads",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_store_quads"],
    visibility = ["//visibility:public"],
    deps = with_proto_bindings(all_crate_deps(normal = True)),
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_store_quads",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":ultragraphdb_store_quads",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

# One rust_test, not a suite: tests/ mirrors src/, so the test files are modules reached through tests/mod.rs.
rust_test(
    name = "ultragraphdb_store_quads_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = ["tests/bdd.rs"],
    ),
    crate_root = "tests/mod.rs",
    data = glob(
        ["testdata/**"],
        allow_empty = True,
    ),
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_store_quads"] + with_proto_bindings(all_crate_deps(
        normal = True,
        normal_dev = True,
    )),
)

# The bdd target joins with the crate's first scenario (stage 4, group 6).
