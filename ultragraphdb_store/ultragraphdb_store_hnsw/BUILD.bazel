load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test")
load("//bazel/rust:deps.bzl", "with_proto_bindings")

rust_library(
    name = "ultragraphdb_store_hnsw",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_store_hnsw"],
    visibility = ["//visibility:public"],
    deps = with_proto_bindings(all_crate_deps(normal = True)),
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_store_hnsw",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":ultragraphdb_store_hnsw",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

# One rust_test, not a suite: tests/ mirrors src/, so the test files are modules reached through tests/mod.rs. It
# reads the golden vectors and holds the fixed seed set of the vector-index workload on the simulated store, and
# its run on fjall under TEST_TMPDIR.
rust_test(
    name = "ultragraphdb_store_hnsw_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = ["tests/bdd.rs"],
    ),
    crate_root = "tests/mod.rs",
    data = glob(["testdata/**"]),
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_store_hnsw"] + with_proto_bindings(all_crate_deps(
        normal = True,
        normal_dev = True,
    )),
)

# cucumber runs its own main: the libtest harness is off, and the feature files are runfiles. bdd.rs includes the
# test helpers of the unit tests by path.
rust_test(
    name = "bdd",
    srcs = [
        "tests/bdd.rs",
        "tests/utils/helpers.rs",
    ],
    crate_root = "tests/bdd.rs",
    data = glob(["features/**/*.feature"]),
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_store_hnsw"] + with_proto_bindings(all_crate_deps(
        normal = True,
        normal_dev = True,
    )),
)
