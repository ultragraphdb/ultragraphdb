load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test")

# `test-utils` is on by default under Cargo and mirrored here, so Cargo and Bazel compile the same library.
# The library's dependencies, and the aliases of those alone: `aliases()` names the dev-dependencies too, and every label it
# names is a dependency of the library in Bazel's graph, and so of every binary over it.
LIBRARY_DEPS = all_crate_deps(normal = True)

rust_library(
    name = "ultragraphdb_traits_catalog",
    srcs = glob(["src/**/*.rs"]),
    aliases = {label: name for label, name in aliases().items() if label in LIBRARY_DEPS},
    crate_features = ["test-utils"],
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    # lint_config turns cfg checking on (`--check-cfg=cfg(loom)`) without declaring the crate's features, which cargo
    # declares from `[features]`: the same declaration here, so `#[cfg(feature = ...)]` is checked as under cargo.
    rustc_flags = ["--check-cfg=cfg(feature, values(\"default\", \"test-utils\"))"],
    tags = ["ultragraphdb_traits_catalog"],
    visibility = ["//visibility:public"],
    deps = LIBRARY_DEPS,
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_traits_catalog",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_doc_test(
    name = "doc_test",
    crate = ":ultragraphdb_traits_catalog",
    tags = ["doc-test"],
    visibility = ["//visibility:public"],
)

# One rust_test, not a suite: tests/ mirrors src/, so the test files are modules reached through tests/mod.rs.
rust_test(
    name = "ultragraphdb_traits_catalog_tests",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/mod.rs",
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_traits_catalog"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
