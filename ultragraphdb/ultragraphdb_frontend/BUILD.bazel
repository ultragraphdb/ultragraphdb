load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:push.bzl", "image_push")
load("//bazel:binary.bzl", "static_binary")
load("//bazel/container:img.bzl", "glibc_multiarch_img", "seccomp_referrer", "sha256_tag")

# No library: `main`, and `service`, the role's work.
static_binary(
    name = "ultragraphdb_frontend",
    srcs = glob(["src/**/*.rs"]),
    tags = ["role_binary"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

# Buid for amd64 and arm64 with `-c opt`.
glibc_multiarch_img(
    name = "ultragraphdb_frontend_multiarch",
    binary = ":ultragraphdb_frontend",
    visibility = ["//visibility:public"],
)

# Buid for amd64 and arm64 with `-c opt`.
sha256_tag(
    name = "ultragraphdb_frontend_tag",
    image = ":ultragraphdb_frontend_multiarch",
)

# Loads the image into the local Docker daemon: `bazel run -c opt :load -- --platform linux/arm64`.
image_load(
    name = "load",
    image = ":ultragraphdb_frontend_multiarch",
    registry = "docker.io",
    repository = "hansenmarvin/ultragraphdb_frontend",
    tag = "dev",
    visibility = ["//visibility:public"],
)

# Loads the image under the tag the image scenarios use, so a test run leaves the `dev` tag a developer loads alone.
image_load(
    name = "test_load",
    image = ":ultragraphdb_frontend_multiarch",
    registry = "docker.io",
    repository = "hansenmarvin/ultragraphdb_frontend",
    tag = "image-test",
    visibility = ["//visibility:public"],
)

# The shipped seccomp profile, pushed with the image as its referrer.
seccomp_referrer(
    name = "ultragraphdb_frontend_seccomp",
    image = ":ultragraphdb_frontend_multiarch",
)

# `bazel build` only produces the pusher; `bazel run -c opt` publishes the image and its seccomp profile. Credentials come from
# the Docker configuration.
image_push(
    name = "push",
    image = ":ultragraphdb_frontend_multiarch",
    referrers = [":ultragraphdb_frontend_seccomp"],
    registry = "index.docker.io",
    repository = "hansenmarvin/ultragraphdb_frontend",
    tag_file = ":ultragraphdb_frontend_tag",
    visibility = ["//visibility:public"],
)
