load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# The binaries as processes: each is copied into the sandbox, and the test starts it. No container is involved, so Bazel
# caches the result. The ports are declared and fixed, so `exclusive` keeps any other test from running beside this one; it
# stays sandboxed.
rust_test(
    name = "bdd",
    srcs = [
        "tests/bdd.rs",
        "tests/played_home.rs",
        "tests/read_kernel_steps.rs",
    ],
    crate_root = "tests/bdd.rs",
    data = glob(["features/**/*.feature"]) + [
        ":copy_config",
        ":copy_frontend",
        ":copy_storage",
    ],
    tags = [
        "exclusive",
        "integration_test",
    ],
    use_libtest_harness = False,
    deps = all_crate_deps(normal_dev = True),
)

# Copy the config binary into the sandbox.
copy_file(
    name = "copy_config",
    src = "//ultragraphdb/ultragraphdb_config:ultragraphdb_config",
    out = "ultragraphdb_config",
    is_executable = True,
)

# Copy the frontend binary into the sandbox.
copy_file(
    name = "copy_frontend",
    src = "//ultragraphdb/ultragraphdb_frontend:ultragraphdb_frontend",
    out = "ultragraphdb_frontend",
    is_executable = True,
)

# Copy the storage binary into the sandbox.
copy_file(
    name = "copy_storage",
    src = "//ultragraphdb/ultragraphdb_storage:ultragraphdb_storage",
    out = "ultragraphdb_storage",
    is_executable = True,
)
