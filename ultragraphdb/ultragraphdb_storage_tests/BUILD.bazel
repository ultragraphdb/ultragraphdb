load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel:test_ports.bzl", "port_env")

# The binaries as processes: each is copied into the sandbox, and the test starts it. No container is involved, so Bazel
# caches the result. Every target listens in a block of ports of its own, from the base `port_env` sets, so the targets run
# side by side; each stays sandboxed.
#
# `bdd.rs` runs every feature in its runfiles but those tagged `@system` and `@drops`, so each feature file without those tags
# is a target of its own, its runfiles holding it alone. `drops_bdd` runs the `@drops` features, the Drops a client sends
# through compute, by `BDD_FEATURES`. `system_bdd.rs` runs the features tagged `@system`, the storage binary hosting the
# system group, one target per second tag. The tagged features are those under `features/system/` and
# `features/schema-changes/drops.feature`; a feature tagged elsewhere is left out of its file's target by its tag.
BDD_SRCS = [
    "tests/bdd.rs",
    "tests/drop_steps.rs",
    "tests/lost_group_steps.rs",
    "tests/one_frame_steps.rs",
    "tests/parked_steps.rs",
    "tests/played_system.rs",
    "tests/played_home.rs",
    "tests/read_kernel_steps.rs",
    "tests/retention_steps.rs",
    "tests/scan_ranges_steps.rs",
]

BDD_DATA = [
    ":copy_compute",
    ":copy_config",
    ":copy_storage",
]

SYSTEM_SRCS = [
    "tests/system_bdd.rs",
    "tests/system_books_steps.rs",
]

# No compute process runs in the system group's scenarios.
SYSTEM_DATA = [
    ":copy_config",
    ":copy_storage",
]

ALL_FEATURES = glob(["features/**/*.feature"])

# Each target: its name, its crate root, its sources, its runfiles and its variables beside the port base.
TARGETS = [
    (
        "bdd_" + feature.removeprefix("features/").removesuffix(".feature").replace("/", "_").replace("-", "_"),
        "tests/bdd.rs",
        BDD_SRCS,
        [feature] + BDD_DATA,
        {},
    )
    for feature in glob(
        ["features/**/*.feature"],
        exclude = [
            "features/system/**",
            "features/schema-changes/drops.feature",
        ],
    )
] + [
    (
        "drops_bdd",
        "tests/bdd.rs",
        BDD_SRCS,
        ALL_FEATURES + BDD_DATA,
        {"BDD_FEATURES": "drops"},
    ),
] + [
    (
        name,
        "tests/system_bdd.rs",
        SYSTEM_SRCS,
        ALL_FEATURES + SYSTEM_DATA,
        {"SYSTEM_FEATURES": features},
    )
    for name, features in [
        ("system_bdd", "hosting"),
        ("system_partitions_bdd", "partitions"),
        ("system_books_bdd", "books"),
    ]
]

[
    rust_test(
        name = name,
        srcs = srcs,
        crate_root = crate_root,
        data = data,
        env = port_env(index, env),
        tags = ["integration_test", "storage-integration-test"],
        use_libtest_harness = False,
        deps = all_crate_deps(normal_dev = True),
    )
    for index, (name, crate_root, srcs, data, env) in enumerate(TARGETS)
]

# Copy the config binary into the sandbox.
copy_file(
    name = "copy_config",
    src = "//ultragraphdb/ultragraphdb_config",
    out = "ultragraphdb_config",
    is_executable = True,
)

# Copy the compute binary into the sandbox.
copy_file(
    name = "copy_compute",
    src = "//ultragraphdb/ultragraphdb_compute",
    out = "ultragraphdb_compute",
    is_executable = True,
)

# Copy the storage binary into the sandbox.
copy_file(
    name = "copy_storage",
    src = "//ultragraphdb/ultragraphdb_storage",
    out = "ultragraphdb_storage",
    is_executable = True,
)
