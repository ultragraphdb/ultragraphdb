load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:push.bzl", "image_push")
load("//bazel:binary.bzl", "static_binary")
load("//bazel/container:img.bzl", "scratch_multiarch_img", "sha256_tag")

# No library: `main` and the start it runs, over the store and the API of `ultragraphdb_common_config`.
static_binary(
    name = "ultragraphdb_config",
    srcs = glob(["src/**/*.rs"]),
    tags = ["config_binary"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

# Build for amd64 and arm64 with `-c opt`.
scratch_multiarch_img(
    name = "ultragraphdb_config_multiarch",
    binary = ":ultragraphdb_config",
    visibility = ["//visibility:public"],
)

# A simple sha256 tag.
sha256_tag(
    name = "ultragraphdb_config_tag",
    image = ":ultragraphdb_config_multiarch",
)

# Loads the image into the local Docker daemon: `bazel run -c opt :load -- --platform linux/arm64`.
image_load(
    name = "load",
    image = ":ultragraphdb_config_multiarch",
    registry = "docker.io",
    repository = "hansenmarvin/ultragraphdb_config",
    tag = "dev",
    visibility = ["//visibility:public"],
)

# Loads the image under the tag the image scenarios use, so a test run leaves the `dev` tag a developer loads alone.
image_load(
    name = "test_load",
    image = ":ultragraphdb_config_multiarch",
    registry = "docker.io",
    repository = "hansenmarvin/ultragraphdb_config",
    tag = "image-test",
    visibility = ["//visibility:public"],
)

# `bazel build` only produces the pusher; `bazel run -c opt` publishes. Credentials come from the Docker configuration.
image_push(
    name = "push",
    image = ":ultragraphdb_config_multiarch",
    registry = "index.docker.io",
    repository = "hansenmarvin/ultragraphdb_config",
    tag_file = ":ultragraphdb_config_tag",
    visibility = ["//visibility:public"],
)

# The development profiles: central files with their settings, which the container of group 11 seeds a service from.
filegroup(
    name = "profiles",
    srcs = glob(["profiles/**/*.toml"]),
    visibility = ["//visibility:public"],
)
