load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel:test_ports.bzl", "port_env")

# What the compute binary links, for the test that fails when it links an engine or a book.
genquery(
    name = "compute_deps",
    expression = "deps(//ultragraphdb/ultragraphdb_compute:ultragraphdb_compute)",
    scope = ["//ultragraphdb/ultragraphdb_compute:ultragraphdb_compute"],
)

# The binaries as processes: each is copied into the sandbox, and the test starts it. No container is involved, so Bazel
# caches the result. One target per feature file, each listening in a block of ports of its own (`port_env`), so the targets
# run side by side; each stays sandboxed. A target's runfiles hold its feature file alone, and cucumber runs what `features/`
# holds.
[
    rust_test(
        name = "bdd_" + feature.removeprefix("features/").removesuffix(".feature").replace("/", "_").replace("-", "_"),
        srcs = glob(["tests/**/*.rs"]),
        crate_root = "tests/bdd.rs",
        data = [feature] + [
            ":copy_compute",
            ":copy_storage",
            ":compute_deps",
        ],
        env = port_env(index),
        tags = ["integration_test", "compute-integration-test"],
        use_libtest_harness = False,
        deps = all_crate_deps(normal_dev = True),
    )
    for index, feature in enumerate(glob(["features/**/*.feature"]))
]

# Copy the compute binary into the sandbox.
copy_file(
    name = "copy_compute",
    src = "//ultragraphdb/ultragraphdb_compute:ultragraphdb_compute",
    out = "ultragraphdb_compute",
    is_executable = True,
)

# Copy the storage binary into the sandbox.
copy_file(
    name = "copy_storage",
    src = "//ultragraphdb/ultragraphdb_storage:ultragraphdb_storage",
    out = "ultragraphdb_storage",
    is_executable = True,
)
