load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc")

rust_library(
    name = "ultragraphdb_frontend_specs",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_frontend_specs"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_frontend_specs",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "ultragraphdb_frontend_specs_tests",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/mod.rs",
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_frontend_specs"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
