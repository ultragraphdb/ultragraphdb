load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel:binary.bzl", "static_binary")

# No library: the check is reached from its crate, and a binary holds only `main`.
static_binary(
    name = "ultragraphdb_config_cli",
    srcs = ["src/main.rs"],
    tags = ["config_binary"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)
