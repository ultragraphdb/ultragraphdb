load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//bazel:test_ports.bzl", "port_env")

# What the frontend binary links, for the test that fails when it links an engine.
genquery(
    name = "frontend_deps",
    expression = "deps(//ultragraphdb/ultragraphdb_frontend:ultragraphdb_frontend)",
    scope = ["//ultragraphdb/ultragraphdb_frontend"],
)

# The feature files, one scenario target each, so the targets run side by side and each ends within its time.
FEATURES = glob(["features/**/*.feature"])

# The binaries as processes: each is copied into the sandbox, and the test starts it. No container is involved, so Bazel
# caches the result. Each target's processes listen in a block of ports of its own, from the base `port_env` sets
# (`bazel/test_ports.bzl`), so the targets run beside each other and beside every other package's; it stays sandboxed. A
# target is named for its feature file's path under `features/`.
[
    rust_test(
        name = "bdd_" + feature.removeprefix("features/").removesuffix(".feature").replace("/", "_").replace("-", "_"),
        srcs = [
            "tests/bdd.rs",
            "tests/books_steps.rs",
            "tests/endpoint_steps.rs",
            "tests/processes.rs",
            "tests/role_read_steps.rs",
            "tests/system_steps.rs",
        ],
        crate_root = "tests/bdd.rs",
        data = [
            feature,
            ":copy_compute",
            ":copy_frontend",
            ":copy_storage",
            ":frontend_deps",
        ],
        env = port_env(index),
        tags = ["integration_test", "frontend-integration-test"],
        use_libtest_harness = False,
        deps = all_crate_deps(normal_dev = True),
    )
    for index, feature in enumerate(FEATURES)
]

# Copy the frontend binary into the sandbox.
copy_file(
    name = "copy_frontend",
    src = "//ultragraphdb/ultragraphdb_frontend:ultragraphdb_frontend",
    out = "ultragraphdb_frontend",
    is_executable = True,
)

# Copy the compute binary into the sandbox.
copy_file(
    name = "copy_compute",
    src = "//ultragraphdb/ultragraphdb_compute:ultragraphdb_compute",
    out = "ultragraphdb_compute",
    is_executable = True,
)

# Copy the storage binary into the sandbox.
copy_file(
    name = "copy_storage",
    src = "//ultragraphdb/ultragraphdb_storage:ultragraphdb_storage",
    out = "ultragraphdb_storage",
    is_executable = True,
)
