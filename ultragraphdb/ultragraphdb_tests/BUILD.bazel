load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "ultragraphdb_tests",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_tests"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

# The harness's own unit tests, mirroring `src/`: they start no binary and bind no address a scenario declares.
rust_test(
    name = "unit",
    srcs = glob([
        "tests/mod.rs",
        "tests/utils/**/*.rs",
    ]),
    crate_root = "tests/mod.rs",
    tags = ["unit-test"],
    deps = [":ultragraphdb_tests"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Whole clusters as processes: each is copied into the sandbox, and the test starts it, its dependencies first. No
# container is involved, so Bazel caches the result. The ports are declared and fixed, so `exclusive` keeps any other test
# from running beside this one; it stays sandboxed. The golden bodies are the conversations the client's conformance suite
# plays, here sent to the real binaries.
rust_test(
    name = "bdd",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/bdd.rs",
    data = glob(["features/**/*.feature"]) + [
        "//ultragraphdb_protocol/ultragraphdb_protocol_wire:golden_bodies",
        ":copy_config",
        ":copy_compute",
        ":copy_frontend",
        ":copy_storage",
    ],
    tags = [
        "exclusive",
        "integration_test",
    ],
    use_libtest_harness = False,
    deps = [":ultragraphdb_tests"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Copy the config service into the sandbox.
copy_file(
    name = "copy_config",
    src = "//ultragraphdb/ultragraphdb_config:ultragraphdb_config",
    out = "ultragraphdb_config",
    is_executable = True,
)

# Copy the compute binary into the sandbox.
copy_file(
    name = "copy_compute",
    src = "//ultragraphdb/ultragraphdb_compute:ultragraphdb_compute",
    out = "ultragraphdb_compute",
    is_executable = True,
)

# Copy the frontend binary into the sandbox.
copy_file(
    name = "copy_frontend",
    src = "//ultragraphdb/ultragraphdb_frontend:ultragraphdb_frontend",
    out = "ultragraphdb_frontend",
    is_executable = True,
)

# Copy the storage binary into the sandbox.
copy_file(
    name = "copy_storage",
    src = "//ultragraphdb/ultragraphdb_storage:ultragraphdb_storage",
    out = "ultragraphdb_storage",
    is_executable = True,
)
