load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc")

# The library's dependencies, and the aliases of those alone: `aliases()` names the dev-dependencies too, and every label it
# names is a dependency of the library in Bazel's graph, and so of every binary over it.
LIBRARY_DEPS = all_crate_deps(normal = True)

rust_library(
    name = "ultragraphdb_common_system",
    srcs = glob(["src/**/*.rs"]),
    aliases = {label: name for label, name in aliases().items() if label in LIBRARY_DEPS},
    crate_features = ["test-utils"],
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    # lint_config turns cfg checking on (`--check-cfg=cfg(loom)`) without declaring the crate's features, which cargo
    # declares from `[features]`: the same declaration here, so `#[cfg(feature = ...)]` is checked as under cargo.
    rustc_flags = ["--check-cfg=cfg(feature, values(\"default\", \"test-utils\"))"],
    tags = ["ultragraphdb_common_system"],
    visibility = ["//visibility:public"],
    deps = LIBRARY_DEPS,
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_common_system",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

# One rust_test, not a suite: tests/ mirrors src/, so the test files are modules reached through tests/mod.rs.
rust_test(
    name = "ultragraphdb_common_system_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = [
            "tests/bdd.rs",
            "tests/bdd_stage.rs",
            "tests/books_steps.rs",
            "tests/system_steps.rs",
            "tests/property/**",
        ],
    ),
    crate_root = "tests/mod.rs",
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_common_system"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The property tests, Hegel's, under `tests/property/`, mirroring `src/`. Derandomized and without an example database,
# so a run is a function of its sources and Bazel may cache it. Two targets over the one tree, split by libtest's filter
# on the catalog's test file: its version past the cap, 16 MiB declared three times, takes about 3.7 s, the other nine
# tests under 1 s together, and Bazel runs the two beside each other.
[
    rust_test(
        name = name,
        srcs = glob(["tests/property/**/*.rs"]),
        args = args,
        crate_root = "tests/property/mod.rs",
        env = {
            "HEGEL_DATABASE": "disabled",
            "HEGEL_DERANDOMIZE": "true",
        },
        tags = ["property-test"],
        deps = [":ultragraphdb_common_system"] + all_crate_deps(
            normal = True,
            normal_dev = True,
        ),
    )
    for name, args in [
        (
            "property",
            [
                "--skip",
                "types::system_group::system_group_catalog_property_tests::",
            ],
        ),
        (
            "property_catalog",
            ["types::system_group::system_group_catalog_property_tests::"],
        ),
    ]
]

# The scenarios' sources, which both BDD targets below compile.
BDD_SRCS = [
    "tests/bdd.rs",
    "tests/bdd_stage.rs",
    "tests/books_steps.rs",
    "tests/system_steps.rs",
]

# The feature building a catalog version to its cap, which takes a target of its own: a target's runfiles hold its feature
# files alone, and cucumber runs what `features/` holds.
CATALOG_CAP = "features/metadata-group/catalog_cap.feature"

# cucumber runs its own main: the libtest harness is off, and the feature files are runfiles.
rust_test(
    name = "bdd",
    srcs = BDD_SRCS,
    crate_root = "tests/bdd.rs",
    # The manifest is read by the scenarios naming what the group's host links.
    data = glob(
        ["features/**/*.feature"],
        exclude = [CATALOG_CAP],
    ) + ["Cargo.toml"],
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_common_system"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "bdd_catalog_cap",
    srcs = BDD_SRCS,
    crate_root = "tests/bdd.rs",
    data = [CATALOG_CAP],
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_common_system"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
