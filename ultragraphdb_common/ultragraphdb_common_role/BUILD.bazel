load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc")

# The library's dependencies, and the aliases of those alone: `aliases()` names the dev-dependencies too, and every label it
# names is a dependency of the library in Bazel's graph, and so of every binary over it.
LIBRARY_DEPS = all_crate_deps(normal = True)

rust_library(
    name = "ultragraphdb_common_role",
    srcs = glob(["src/**/*.rs"]),
    aliases = {label: name for label, name in aliases().items() if label in LIBRARY_DEPS},
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_common_role"],
    visibility = ["//visibility:public"],
    deps = LIBRARY_DEPS,
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_common_role",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "ultragraphdb_common_role_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = [
            "tests/bdd.rs",
            "tests/loom/**",
            "tests/property/**",
        ],
    ),
    crate_root = "tests/mod.rs",
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_common_role"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The property tests, Hegel's, under `tests/property/`, mirroring `src/`. Derandomized and without an example database,
# so a run is a function of its sources and Bazel may cache it.
rust_test(
    name = "property",
    srcs = glob(["tests/property/**/*.rs"]),
    crate_root = "tests/property/mod.rs",
    env = {
        "HEGEL_DATABASE": "disabled",
        "HEGEL_DERANDOMIZE": "true",
    },
    tags = ["property-test"],
    deps = [":ultragraphdb_common_role"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The library again under `--cfg loom`, its connection count built on Loom's types, for the Loom tests alone.
rust_library(
    name = "ultragraphdb_common_role_loom",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = {label: name for label, name in aliases().items() if label in LIBRARY_DEPS},
    crate_name = "ultragraphdb_common_role",
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    rustc_flags = [
        "--cfg",
        "loom",
    ],
    deps = LIBRARY_DEPS + ["@crates//:loom"],
)

# The Loom tests, under `tests/loom/`, mirroring `src/`: every interleaving of each model's threads, against the
# library built under `--cfg loom`.
rust_test(
    name = "loom",
    srcs = glob(["tests/loom/**/*.rs"]),
    crate_root = "tests/loom/mod.rs",
    rustc_flags = [
        "--cfg",
        "loom",
    ],
    tags = ["loom-test"],
    deps = [
        ":ultragraphdb_common_role_loom",
        "@crates//:loom",
    ],
)

# cucumber runs its own main: the libtest harness is off, and the feature files are runfiles.
rust_test(
    name = "bdd",
    srcs = ["tests/bdd.rs"],
    crate_root = "tests/bdd.rs",
    data = glob(["features/**/*.feature"]),
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_common_role"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
