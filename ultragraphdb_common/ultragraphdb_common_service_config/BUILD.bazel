load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc")

rust_library(
    name = "ultragraphdb_common_service_config",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_common_service_config"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_common_service_config",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

# One rust_test, not a suite: tests/ mirrors src/, so the test files are modules reached through tests/mod.rs.
rust_test(
    name = "ultragraphdb_common_service_config_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = [
            "tests/bdd.rs",
            "tests/property/**",
        ],
    ),
    crate_root = "tests/mod.rs",
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_common_service_config"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The property tests, Hegel's, under `tests/property/`, mirroring `src/`. Derandomized and without an example database,
# so a run is a function of its sources and Bazel may cache it.
rust_test(
    name = "property",
    srcs = glob(["tests/property/**/*.rs"]),
    crate_root = "tests/property/mod.rs",
    env = {
        "HEGEL_DATABASE": "disabled",
        "HEGEL_DERANDOMIZE": "true",
    },
    tags = ["property-test"],
    deps = [":ultragraphdb_common_service_config"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# cucumber runs its own main: the libtest harness is off, and the feature files are runfiles.
rust_test(
    name = "bdd",
    srcs = ["tests/bdd.rs"],
    crate_root = "tests/bdd.rs",
    data = glob(["features/**/*.feature"]),
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_common_service_config"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
