load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc")

# The library's dependencies, and the aliases of those alone: `aliases()` names the dev-dependencies too, and every label it
# names is a dependency of the library in Bazel's graph, and so of every binary over it.
LIBRARY_DEPS = all_crate_deps(normal = True)

rust_library(
    name = "ultragraphdb_common_storage",
    srcs = glob(["src/**/*.rs"]),
    aliases = {label: name for label, name in aliases().items() if label in LIBRARY_DEPS},
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_common_storage"],
    visibility = ["//visibility:public"],
    deps = LIBRARY_DEPS,
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_common_storage",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

# One rust_test tree, tests/mod.rs mirroring src/, run by two targets split by libtest's filter on the core's reads: 26 of
# the 213 tests, among them those waiting out a Scan's stall and an epoch's deadline on the core's own clock, they take
# about as long as the rest together (measured 2026-11-16), so Bazel runs the two beside each other.
[
    rust_test(
        name = name,
        srcs = glob(
            ["tests/**/*.rs"],
            exclude = ["tests/bdd.rs"],
        ),
        args = args,
        crate_root = "tests/mod.rs",
        tags = ["unit-test"],
        visibility = ["//visibility:public"],
        deps = [":ultragraphdb_common_storage"] + all_crate_deps(
            normal = True,
            normal_dev = True,
        ),
    )
    for name, args in [
        (
            "ultragraphdb_common_storage_tests",
            [
                "--skip",
                "types::partition_core::partition_core_reads_tests::",
            ],
        ),
        (
            "ultragraphdb_common_storage_reads",
            ["types::partition_core::partition_core_reads_tests::"],
        ),
    ]
]
