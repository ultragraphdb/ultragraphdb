load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc")

rust_library(
    name = "ultragraphdb_common_frontend",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["test-utils"],
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_common_frontend"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_common_frontend",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "ultragraphdb_common_frontend_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = ["tests/bdd.rs"],
    ),
    crate_root = "tests/mod.rs",
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_common_frontend"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# cucumber runs its own main: the libtest harness is off, and the feature files are runfiles.
rust_test(
    name = "bdd",
    srcs = [
        "tests/bdd.rs",
        "tests/endpoint_stage.rs",
        "tests/endpoint_steps.rs",
        "tests/endpoint_steps_requests.rs",
        "tests/endpoint_steps_sessions.rs",
        "tests/on_way_steps.rs",
        "tests/tightening_steps.rs",
    ],
    crate_root = "tests/bdd.rs",
    data = glob(["features/**/*.feature"]),
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_common_frontend"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
