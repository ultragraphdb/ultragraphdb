load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc")
load("//bazel:binary.bzl", "static_binary")
load("//bazel/container:img.bzl", "glibc_multiarch_img", "scratch_multiarch_img", "sha256_tag")

rust_library(
    name = "ultragraphdb_tool_bench",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_tool_bench"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

# The measurements of stage 2, task 10.2, run by hand with `bazel run -c opt :store_bench -- <run>`; no test runs it.
static_binary(
    name = "store_bench",
    srcs = ["src/bin/store_bench.rs"],
    main = "src/bin/store_bench.rs",
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_tool_bench"] + all_crate_deps(normal = True),
)

# Stage 5's measurement of the write-ahead log beside fjall's journal, task 12.5, run by hand with
# `bazel run -c opt :wal_bench -- --dir <path> --rate <r>`; no test runs it.
static_binary(
    name = "wal_bench",
    srcs = ["src/bin/wal_bench.rs"],
    main = "src/bin/wal_bench.rs",
    tags = ["bench"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_tool_bench"] + all_crate_deps(normal = True),
)

# `wal_bench` for a profiler: the release optimisation with its symbols, line tables and frame pointers kept, so
# `perf record -g` resolves its stacks (backlog item 11). Build with `-c opt`.
static_binary(
    name = "wal_bench_profile",
    srcs = ["src/bin/wal_bench.rs"],
    main = "src/bin/wal_bench.rs",
    release_flags = [
        "-Copt-level=3",
        "-Ccodegen-units=1",
        "-Cdebuginfo=line-tables-only",
        "-Cforce-frame-pointers=yes",
        "-Cpanic=unwind",
    ],
    tags = ["bench"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_tool_bench"] + all_crate_deps(normal = True),
)

# The log's benchmark as a multi-arch scratch image, so it runs on a Linux host's own drives (the sync cost on drives
# with and without power-loss protection, backlog item 7). Build with `-c opt`.
scratch_multiarch_img(
    name = "wal_bench_multiarch",
    binary = ":wal_bench",
    visibility = ["//visibility:public"],
)

# The same benchmark on the glibc base the server ships on (D7): measures the server's libc and image on a Linux
# host. Build with `-c opt`.
glibc_multiarch_img(
    name = "wal_bench_glibc_multiarch",
    binary = ":wal_bench",
    visibility = ["//visibility:public"],
)

# Loads the glibc image into the local Docker daemon: `bazel run -c opt :wal_bench_glibc_load`.
image_load(
    name = "wal_bench_glibc_load",
    image = ":wal_bench_glibc_multiarch",
    tag = "ultragraphdb/wal_bench:glibc",
)

# A tag naming the image by its own content.
sha256_tag(
    name = "wal_bench_tag",
    image = ":wal_bench_multiarch",
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_tool_bench",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

# One rust_test: tests/ mirrors src/ through tests/mod.rs. The argument parsing, the commit shape, the pacer against a
# clock moved by hand, the summaries, the /proc readers, the timed store and the directory sizes; and short runs of
# each measurement, apply runs of one second at 10 commits a second, their timed figures checked by their invariants.
rust_test(
    name = "ultragraphdb_tool_bench_tests",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/mod.rs",
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_tool_bench"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The in-src #[cfg(test)] module of src/utils/apply_run.rs: the report's arithmetic over private figures, which a test
# under tests/ cannot reach. Built from the library crate's own sources and deps.
rust_test(
    name = "ultragraphdb_tool_bench_src_tests",
    crate = ":ultragraphdb_tool_bench",
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
)
