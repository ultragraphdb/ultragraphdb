load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# The helpers the store crates' test targets share. Bazel compiles each test target from its own sources, so a helper
# more than one target uses lives in a library they depend on.
# The library's dependencies, and the aliases of those alone: `aliases()` names the dev-dependencies too, and every label it
# names is a dependency of the library in Bazel's graph, and so of every binary over it.
LIBRARY_DEPS = all_crate_deps(normal = True)

rust_library(
    name = "ultragraphdb_tool_test",
    srcs = glob(["src/**/*.rs"]),
    aliases = {label: name for label, name in aliases().items() if label in LIBRARY_DEPS},
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_tool_test"],
    visibility = ["//visibility:public"],
    deps = LIBRARY_DEPS,
)

# The helpers' own unit tests, mirroring `src/`.
rust_test(
    name = "ultragraphdb_tool_test_tests",
    srcs = glob(["tests/**/*.rs"]),
    crate_root = "tests/mod.rs",
    tags = ["unit-test"],
    deps = [":ultragraphdb_tool_test"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
