load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc")

rust_library(
    name = "ultragraphdb_protocol_wire",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_protocol_wire"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_protocol_wire",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

# One rust_test, not a suite: tests/ mirrors src/, so the test files are modules reached through tests/mod.rs. The
# golden frames, the xxHash reference vectors and the fuzz regressions are runfiles.
rust_test(
    name = "ultragraphdb_protocol_wire_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = [
            "tests/bdd.rs",
            "tests/bodies_steps.rs",
        ],
    ),
    crate_root = "tests/mod.rs",
    data = glob(["testdata/**"]),
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_protocol_wire"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# cucumber runs its own main: the libtest harness is off, and the feature files and golden frames are runfiles. bdd.rs
# includes the unit tests' golden-frame helpers by path, and the body scenarios' steps from bodies_steps.rs.
rust_test(
    name = "bdd",
    srcs = [
        "tests/bdd.rs",
        "tests/bodies_steps.rs",
        "tests/utils/golden.rs",
        "tests/utils/golden_bodies.rs",
    ],
    crate_root = "tests/bdd.rs",
    data = glob([
        "features/**/*.feature",
        "testdata/**",
    ]),
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_protocol_wire"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The golden frames, for the conformance suites of the crates that speak the protocol (the Rust client's core).
filegroup(
    name = "golden_bodies",
    srcs = glob(["testdata/golden/bodies/*.frame"]),
    visibility = ["//visibility:public"],
)
