load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc")

rust_library(
    name = "ultragraphdb_protocol_transport",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_protocol_transport"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_protocol_transport",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

# One rust_test, not a suite: tests/ mirrors src/, so the test files are modules reached through tests/mod.rs.
rust_test(
    name = "ultragraphdb_protocol_transport_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = [
            "tests/bdd.rs",
            "tests/loom/**",
        ],
    ),
    crate_root = "tests/mod.rs",
    # The address_parse fuzz target's seeds, which a unit test parses one by one.
    data = glob(["testdata/fuzz_seeds/address_parse/*"]),
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_protocol_transport"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# The library again under `--cfg loom`, the pool's shared state built on Loom's types, for the Loom tests alone.
rust_library(
    name = "ultragraphdb_protocol_transport_loom",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "ultragraphdb_protocol_transport",
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    rustc_flags = [
        "--cfg",
        "loom",
    ],
    deps = all_crate_deps(normal = True) + ["@crates//:loom"],
)

# The Loom tests, under `tests/loom/`, mirroring `src/`: every interleaving of each model's threads, against the
# library built under `--cfg loom`.
rust_test(
    name = "loom",
    srcs = glob(["tests/loom/**/*.rs"]),
    crate_root = "tests/loom/mod.rs",
    rustc_flags = [
        "--cfg",
        "loom",
    ],
    tags = ["loom-test"],
    deps = [
        ":ultragraphdb_protocol_transport_loom",
        "@crates//:loom",
    ],
)

# cucumber runs its own main: the libtest harness is off, and the feature files are runfiles. bdd.rs includes the unit
# tests' peer and its framer feed by path.
rust_test(
    name = "bdd",
    srcs = [
        "tests/bdd.rs",
        "tests/utils/feed.rs",
        "tests/utils/peer.rs",
    ],
    crate_root = "tests/bdd.rs",
    data = glob(["features/**/*.feature"]),
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_protocol_transport"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
