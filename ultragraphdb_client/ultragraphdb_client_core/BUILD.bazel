load("@crates//:defs.bzl", "aliases", "all_crate_deps", "lint_config")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc")

rust_library(
    name = "ultragraphdb_client_core",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["test-utils"],
    crate_root = "src/lib.rs",
    lint_config = lint_config(),
    tags = ["ultragraphdb_client_core"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_doc(
    name = "doc",
    crate = ":ultragraphdb_client_core",
    tags = ["doc"],
    visibility = ["//visibility:public"],
)

# One rust_test, not a suite: tests/ mirrors src/, so the test files are modules reached through tests/mod.rs.
rust_test(
    name = "ultragraphdb_client_core_tests",
    srcs = glob(
        ["tests/**/*.rs"],
        exclude = ["tests/bdd.rs"],
    ),
    crate_root = "tests/mod.rs",
    data = ["//ultragraphdb_protocol/ultragraphdb_protocol_wire:golden_bodies"],
    tags = ["unit-test"],
    visibility = ["//visibility:public"],
    deps = [":ultragraphdb_client_core"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# cucumber runs its own main: the libtest harness is off, and the feature files are runfiles. bdd.rs includes the unit
# tests' harness by path.
rust_test(
    name = "bdd",
    srcs = [
        "tests/bdd.rs",
        "tests/utils/harness.rs",
    ],
    crate_root = "tests/bdd.rs",
    data = glob(["features/**/*.feature"]),
    tags = ["bdd-test"],
    use_libtest_harness = False,
    deps = [":ultragraphdb_client_core"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
