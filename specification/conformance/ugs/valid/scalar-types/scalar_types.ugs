// expect: compiles
schema scalar_types version 1
prefix st = "https://example.org/scalar_types#"

entity Sample {
  flag:   Bool
  i8:     Int8
  i16:    Int16
  i32:    Int32
  i64:    Int64
  i128:   Int128
  u8:     UInt8
  u16:    UInt16
  u32:    UInt32
  u64:    UInt64
  f32:    Float32
  f64:    Float64
  amount: Decimal(18, 2)
  code:   String
  body:   Text
  blob:   Bytes
  day:    Date
  clock:  Time
  stamp:  DateTime
  local:  LocalDateTime
  span:   Duration
  link:   Iri
}
