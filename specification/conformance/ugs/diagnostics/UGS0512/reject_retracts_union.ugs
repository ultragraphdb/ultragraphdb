// expect: UGS0512 at 18:13
schema corpus version 1
prefix ex = "https://example.org/corpus#"

entity Claim @bitemporal(valid: valid) {
  valid: Interval<DateTime> Optional
  text:  String
}

entity Note @append_only {
  text: String
}

relation Corrects @bitemporal(valid: valid) {
  old:   Claim | Note -> corrected_by*
  fix:   Claim        -> corrects*
  valid: Interval<DateTime> Optional
} @retracts(old)
