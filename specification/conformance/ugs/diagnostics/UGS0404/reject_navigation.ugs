// expect: UGS0404 at 15:21
schema corpus version 1
prefix ex = "https://example.org/corpus#"

entity Person { name: String }
entity Team   { name: String }
entity Club   { name: String }

relation MemberOfTeam {
  member: Person -> memberships*
  team:   Team   -> members*
}

relation MemberOfClub {
  member: Person -> memberships*
  club:   Club   -> members*
}
