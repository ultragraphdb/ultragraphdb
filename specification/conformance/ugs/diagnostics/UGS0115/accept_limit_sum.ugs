// expect: compiles
schema fleet version 1
prefix fl = "https://example.org/fleet#"

entity Account {
  owner: String
}
entity Asset {
  serial: String
}

relation Holds {
  account: Account -> holdings*
  asset:   Asset   -> holders*
  amount:  Int64 @range(0, 1_000_000)
} @limit(sum(amount) <= 5_000_000 per account)
