// expect: compiles
schema library version 1
prefix ex = "https://example.org/library#"

entity Person {
  name:       String
  loan_count: Int32
}

entity Book {
  title: String
}

relation Loan {
  holder: Person -> loans*
  book:   Book   -> borrowers*
}

fn Person.has_loans() -> Bool = exists loans

derive Person.idle: Bool = loan_count = 0
