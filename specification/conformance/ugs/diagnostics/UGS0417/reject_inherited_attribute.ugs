// expect: UGS0417 at 15:3
schema corpus version 1
prefix ex = "https://example.org/corpus#"

entity Person { name: String }
entity Venue  { name: String }

abstract relation Event {
  host:  Person -> hosted*
  guest: Person -> attended*
  place: String
}

relation Party : Event {
  place: Venue -> parties*
}
