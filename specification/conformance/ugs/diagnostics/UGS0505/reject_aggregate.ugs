// expect: UGS0505 at 12:10
schema corpus version 1
prefix ex = "https://example.org/corpus#"

entity Buyer  { name: String }
entity Seller { name: String }

relation Sale @multi {
  buyer:  Buyer  -> purchases*
  seller: Seller -> sales*
  amount: Int64 @range(0, 1000000)
} @limit(avg(amount) <= 1000 per buyer)
