// expect: UGS0225 at 17:46
schema library version 1
prefix ex = "https://example.org/library#"

entity Person {
  name: String
}

entity Book {
  title: String
}

relation Loan {
  holder: Person -> loans*
  book:   Book   -> borrowers*
  due:    DateTime
} @limit(count() <= 3 per holder where due > now())
