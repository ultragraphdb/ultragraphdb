// expect: UGS0228 at 17:40
schema library version 1
prefix ex = "https://example.org/library#"

entity Person {
  name: String
}

entity Book {
  title: String
}

relation Loan {
  holder: Person -> loans*
  book:   Book   -> borrowers*
  fee:    Int32
} @limit(count() <= 3 per holder where fee / 0 > 1)
