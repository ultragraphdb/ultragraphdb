// expect: compiles
schema corpus version 1
prefix ex = "https://example.org/corpus#"

abstract entity Item { name: String }
entity Doc : Item
entity Paper : Doc

abstract relation Link {
  source: Doc -> links_out*
  target: Doc -> links_in*
}

relation Cites : Link {
  citing: Paper as source -> cites*
  cited:  Paper as target -> cited_by*
}
