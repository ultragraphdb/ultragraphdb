// expect: UGS0514 at 14:3
schema corpus version 1
prefix ex = "https://example.org/corpus#"

entity Claim @bitemporal(valid: valid) {
  valid: Interval<DateTime> Optional
  text:  String
}

relation Cites @bitemporal(valid: valid) {
  citing: Claim -> cites*
  cited:  Claim -> cited_by*
  valid:  Interval<DateTime> Optional
} @on_delete(citing: restrict)
