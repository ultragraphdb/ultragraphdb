// expect: compiles
schema corpus version 1
prefix ex = "https://example.org/corpus#"

entity Person { name: String }
entity Car    { plate: String }

abstract relation Owns @colocate(owner) {
  car:   Car             -> owners*
  owner: Person Optional -> cars*
} @on_delete(owner: restrict)

relation Leases : Owns { } @on_delete(owner: restrict)
